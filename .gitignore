# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# live credentials produced by scripts/bulk-create-faculty.ts — never commit
faculty-credentials-*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local compliance-report renders (scripts/test-syllabus-audit-export.ts)
.reports/

# Supabase CLI version-check artifact (re-dirties the tree on every CLI run)
supabase/.temp/

# run-spec.sh checkpoint-runner output — operational, not source
.claude/logs/

# _cp_*_verify/ harness scripts are tracked; the screenshots they produce are
# review artifacts for the HALT-gate human, not source — and untracked PNGs
# here re-dirty the tree on every run, blocking run-spec.sh's clean-tree gate
_cp_*_verify/screens/

# _audit_<feature>/ dirs are throwaway audit-run harnesses per AUDIT_SPEC.md
# §0 ("throwaway verification harnesses under _audit_<feature>/ (git-ignored)")
# — findings live in .claude/findings/ instead. Wrongly committed wholesale
# in d48d30e; untracked (not deleted) to correct that.
_audit_*/
